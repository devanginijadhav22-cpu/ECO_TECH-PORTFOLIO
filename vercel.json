{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard.html"
    },
    {
      "src": "/pledge",
      "dest": "/pledge.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
